[Unit]
Description=pve-power 电量采集服务
Documentation=file:/opt/pve-power/README.md
After=network-online.target
Wants=network-online.target

# 永远不要放弃重启：BMC 可能长时间不正常，而一个彻底死掉的
# 采集进程会在数据里留下无法弥补的缺口。
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/bin/python3 -m pvepower --config /etc/pve-power/config.json collect
WorkingDirectory=/opt/pve-power
Environment=PYTHONPATH=/opt/pve-power
Environment=PYTHONUNBUFFERED=1

# 采集器是一个长期运行的采样循环：停掉就重启，
# 即使 BMC 一段时间不正常也要持续重试。
Restart=always
RestartSec=10

# It needs /dev/ipmi0 and its own state directory, nothing else.
StateDirectory=pve-power
ConfigurationDirectory=pve-power
DeviceAllow=/dev/ipmi0 rw
DeviceAllow=/dev/ipmidev/0 rw
ProtectSystem=strict
ReadWritePaths=/var/lib/pve-power
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
MemoryMax=128M

[Install]
WantedBy=multi-user.target
